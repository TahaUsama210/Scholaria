# --- LLM + embedding providers ---
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=openai          # openai | local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536                 # 1536 for openai 3-small, 384 for all-MiniLM-L6-v2

# --- Reranker ---
RERANKER_PROVIDER=local            # local (cross-encoder) | cohere | none
COHERE_API_KEY=

# --- Postgres / pgvector ---
DATABASE_URL=postgresql+asyncpg://scholaria:scholaria@db:5432/scholaria
DATABASE_URL_SYNC=postgresql+psycopg://scholaria:scholaria@db:5432/scholaria

# --- Retrieval tuning ---
DENSE_TOP_K=20
SPARSE_TOP_K=20
RRF_K=60
RERANK_TOP_N=5

# --- Observability (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000

# --- App ---
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
