# Scholaria configuration. Every value below is optional unless noted; defaults shown.
# Profiles:
#   offline (tests/CI/e2e, no network):  LLM_PROVIDER=fake EMBEDDING_PROVIDER=hash EMBEDDING_DIM=256 RERANKER_PROVIDER=none
#   free "real":  EMBEDDING_PROVIDER=local EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
#                 EMBEDDING_DIM=384 RERANKER_PROVIDER=local, LLM via Groq or Ollama (below)
#   OpenAI:       LLM_PROVIDER=openai EMBEDDING_PROVIDER=openai EMBEDDING_DIM=1536 OPENAI_API_KEY=sk-...

# --- LLM ---
# openai = any OpenAI-compatible chat endpoint; fake = deterministic offline answers.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.1-8b-instant
# Ollama: LLM_BASE_URL=http://localhost:11434/v1       LLM_MODEL=llama3.1 (no key needed)
LLM_BASE_URL=
# Falls back to OPENAI_API_KEY when empty.
LLM_API_KEY=
OPENAI_API_KEY=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
# Request token usage on streams (disable for endpoints that reject stream_options).
LLM_STREAM_USAGE=true

# --- Embeddings ---
# openai | local (sentence-transformers) | hash (deterministic, offline)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Must match the model: 1536 for text-embedding-3-small, 384 for all-MiniLM-L6-v2.
# The vector column is created at migrate time, so changing it needs a fresh schema.
EMBEDDING_DIM=1536
# Optional OpenAI-compatible embeddings endpoint (EMBEDDING_PROVIDER=openai).
EMBEDDING_BASE_URL=

# --- Reranker ---
# local (cross-encoder) | cohere (pip install ".[cohere]") | none
RERANKER_PROVIDER=local
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
COHERE_API_KEY=

# --- Postgres / pgvector ---
DATABASE_URL=postgresql+asyncpg://scholaria:scholaria@db:5432/scholaria
DATABASE_URL_SYNC=postgresql+psycopg://scholaria:scholaria@db:5432/scholaria
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_CONNECT_TIMEOUT_SECONDS=5

# --- Retrieval tuning ---
DENSE_TOP_K=20
SPARSE_TOP_K=20
RRF_K=60
RERANK_TOP_N=5
# Refuse instead of answering when the best reranked chunk scores below this
# (reranker units: cross-encoder logits for RERANKER_PROVIDER=local). Eval-tuned:
# -9 refuses 6/8 out-of-scope questions with 0/47 false refusals. Blank = off.
RERANK_MIN_SCORE=-9
# pgvector >= 0.8 iterative HNSW scans keep course-filtered searches full: off | strict_order | relaxed_order
HNSW_ITERATIVE_SCAN=strict_order

# --- Ingestion ---
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
MAX_UPLOAD_MB=50
# Pending/processing documents idle this long can be re-ingested by re-uploading.
INGEST_STALE_AFTER_SECONDS=900

# --- Rate limiting (per client IP; probes and /metrics are exempt) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_UPLOAD=10/minute
# memory:// is per-process; use redis://host:6379 when running several replicas.
RATE_LIMIT_STORAGE_URI=memory://

# --- Server (python -m app) ---
PORT=8000
# Proxies trusted for X-Forwarded-*; "*" behind a managed load balancer (e.g. Fly.io).
FORWARDED_ALLOW_IPS=127.0.0.1
# Header your edge proxy *sets* to the caller's IP (Fly-Client-IP on Fly); rate limits
# key on it. Leave blank to use the socket peer. Never use X-Forwarded-For here.
CLIENT_IP_HEADER=
# Serve the built frontend (vite dist) at / when set, e.g. /app/static.
STATIC_DIR=
# Load models at startup instead of on the first request (avoids a blocked event loop).
WARM_MODELS_ON_STARTUP=true
# Serve /metrics on a separate private port instead of the public app (e.g. 9091 on Fly).
METRICS_PORT=
METRICS_HOST=0.0.0.0

# --- Observability ---
# Traces export over OTLP/HTTP only when set, e.g. http://jaeger:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=scholaria-api

# --- App ---
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
