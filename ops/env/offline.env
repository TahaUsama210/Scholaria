# Offline profile for compose stacks used in CI, smoke tests and load tests:
# no API keys, no network, no model downloads. Deterministic fake LLM + hashing embedder.
#   SCHOLARIA_ENV_FILE=ops/env/offline.env docker compose ...
LLM_PROVIDER=fake
EMBEDDING_PROVIDER=hash
EMBEDDING_DIM=256
RERANKER_PROVIDER=none
LOG_LEVEL=INFO
# Load tests drive many requests from one client IP; the limiter has its own unit tests.
RATE_LIMIT_ENABLED=false
