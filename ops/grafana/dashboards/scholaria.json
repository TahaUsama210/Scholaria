      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(scholaria_ingest_documents_total{status=\"ready\"}[$__range]))",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
